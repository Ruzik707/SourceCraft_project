# ─── данные ──────────────────────────────────────────────────────────────────
# Выгрузка сборщика, из которой строится витрина рейтинга
REPO_HEALTH_CSV=repo_health_report.csv

# База для сессий, истории оценок и запусков анализа.
# SQLite достаточно для стенда; для продакшена — postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///repo_health.db

# ─── расписание ──────────────────────────────────────────────────────────────
REPO_HEALTH_SCHEDULE=0 3 * * *
SCHEDULER_ENABLED=true
HISTORY_ON_REBUILD=true

# ─── авторизация через Я ID ──────────────────────────────────────────────────
# Приложение заводится на oauth.yandex.ru. В качестве Redirect URI указывается
# <PUBLIC_API_URL>/api/v1/auth/yandex/callback, права: login:info, login:email
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Ключ подписи state и сессий — на стенде обязательно свой
SECRET_KEY=dev-secret-change-me
SESSION_TTL_HOURS=24

# Демо-вход без приложения Яндекса: выдаёт сессию сразу.
# На публичном стенде ОБЯЗАТЕЛЬНО false, иначе войти сможет кто угодно.
ALLOW_DEMO_AUTH=true

# ─── SourceCraft ─────────────────────────────────────────────────────────────
SOURCECRAFT_API=https://api.sourcecraft.tech
# Адреса, по которым сервис пробует получить репозитории пользователя
SOURCECRAFT_REPOS_PATHS=/me/repos,/user/repos,/repos?mine=true

# ─── анализ по запросу ───────────────────────────────────────────────────────
# Команда сборщика для одного репозитория; {full_path} подставляется сервисом.
# Пока пусто — анализ пересчитывает оценку по последнему снимку и пишет об этом.
COLLECTOR_COMMAND=
COLLECTOR_TIMEOUT=900
ANALYSIS_WORKERS=2

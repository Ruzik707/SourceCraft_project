# Copy to .env and fill in. Never commit the real .env.

# --- SourceCraft platform REST API (issues, PRs, CI runs, releases, rating) ---
# Confirmed base URL from https://sourcecraft.dev/portal/docs/en/sourcecraft/operations/api-start
SOURCECRAFT_API_BASE_URL=https://api.sourcecraft.tech
# Personal Access Token, sent as `Authorization: Bearer <token>`.
SOURCECRAFT_TOKEN=

# Optional: path to the `src` CLI binary, used as a fallback for operations
# not (yet) confirmed against the public REST spec (see config/endpoints.yaml
# `verified: false` entries). Leave as "src" if it's on PATH.
SOURCECRAFT_CLI_PATH=src

# --- SourceCraft Security API (AppSec scans / defect groups / findings) ---
# Base URL given directly by hackathon organizers on 2026-09-19 (without /v1).
APPSEC_API_BASE_URL=https://appsec.sourcecraft.tech
# Auth mechanism is NOT documented in the SCS Backend API 1.0.0 draft spec
# (see docs/appsec-api-notes.md). Ask the organizers / #lct-hack support for
# the right scheme. Until then, set whichever of these applies:
APPSEC_TOKEN=
APPSEC_CURL_CONFIG_PATH=

# --- Git-native collection (documentation / activity / code_health / cicd config) ---
# Directory used for shallow clones. Cleared/reused between runs.
COLLECTOR_WORKDIR=.workdir
# How far back to fetch history for activity stats.
COLLECTOR_GIT_SHALLOW_SINCE=366 days ago

# --- Output ---
COLLECTOR_OUTPUT_DIR=output

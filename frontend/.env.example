# ────────────────────────────────────────────────────────────────────────────
# Источник данных.
#   api  — боевой бэкенд сервиса (по умолчанию)
#   mock — снимок данных в public/mock: интерфейс работает без бэкенда
VITE_DATA_SOURCE=api

# То же отдельно для личного кабинета: полезно, пока авторизация ещё не поднята
VITE_AUTH_SOURCE=api

# База API. В разработке /api проксируется Vite на VITE_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Куда Vite проксирует /api при npm run dev
VITE_PROXY_TARGET=http://localhost:8000
